# Copy to .env (never committed). On Vercel, add the same names in Project Settings → Environment Variables.
# Do NOT prefix these with VITE_: that would ship them to every visitor's browser.

# Free Gemini keys, comma separated. Each request starts on the next key.
# Used by both server functions: /api/imagine (pictures from words) and /api/stranger (The Stranger game).
# Players never enter a key: the game runs on these.
# Free-tier limits count per Google Cloud project, so keys from different projects add up; keys from one project don't.
GEMINI_API_KEYS=key1,key2,key3
# Optional: models to try in order
# GEMINI_MODEL=gemini-2.5-flash,gemini-2.5-flash-lite
# Optional: models The Stranger may use, first one by default
# GEMINI_STRANGER_MODEL=gemini-3.5-flash-lite,gemini-3.6-flash

# Secret key from https://enter.pollinations.ai/keys (starts with sk_). Several allowed, comma separated.
POLLINATIONS_API_KEY=sk_your_key
# Optional: image model (default zimage = Z-Image Turbo; flux is cheaper)
# POLLINATIONS_MODEL=zimage
